# ============================================================
# Lab Resource Utilization Platform — Backend Environment
# Copy this file to .env and fill in your actual values.
# Variable names match the ${...} placeholders in application.properties
# ============================================================

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/lab_resource_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ---------- JWT ----------
JWT_SECRET=generate-a-long-random-256-bit-secret-for-production
JWT_EXPIRATION_MS=86400000

# ---------- Mail (Gmail App Password) ----------
# Get yours: Google Account > Security > 2-Step Verification > App Passwords
# Create one for "Mail" and paste the 16-character code here (no spaces)
MAIL_ENABLED=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ---------- Google OAuth2 (optional) ----------
# Google Cloud Console > Credentials > OAuth client ID > Web application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---------- File Uploads ----------
UPLOAD_DIR=uploads
