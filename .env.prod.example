# ============================================================
# Production environment for docker-compose.prod.yml
#
#   cp .env.prod.example .env
#   nano .env          # fill in the REQUIRED values below
#   docker compose -f docker-compose.prod.yml up -d
#
# This file is a template and is committed. The real .env is
# gitignored — never commit it. Keep it chmod 600 on the server.
# ============================================================

# ---------- Image source (GitHub Container Registry) ----------
# Must be lowercase — GHCR rejects uppercase path segments.
IMAGE_PREFIX=badalsingh25/lab-resource-platform
IMAGE_TAG=latest

# Port Nginx binds on the host. Leave 80 behind a security group /
# NSG that allows 80 and 443.
HTTP_PORT=80

# ---------- PostgreSQL (REQUIRED) ----------
POSTGRES_DB=lab_resource_db
POSTGRES_USER=labresource
# Generate:  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------- JWT (REQUIRED) ----------
# Generate:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ---------- First-run admin (REQUIRED) ----------
# The bootstrap SYSTEM_ADMIN account is created on first boot only.
# Log in with it once, then change the password from the UI.
# Generate:  openssl rand -base64 18
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- CORS ----------
# Nginx serves the SPA and the API on one origin, so this is normally
# left empty. Set it only if a separate frontend host calls this API.
# Comma-separated, scheme included, no trailing slash. Never "*".
CORS_ALLOWED_ORIGINS=

# ---------- Mail (optional — OTP + notification email) ----------
# With MAIL_ENABLED=false, OTPs are written to the backend log instead.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=no-reply@labresource.com
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Google OAuth2 (optional) ----------
# Add the deployed origin to "Authorised JavaScript origins" in the
# Google Cloud console, or the sign-in button returns origin_mismatch.
GOOGLE_CLIENT_ID=

# ---------- SMS via Twilio (optional — urgent alerts only) ----------
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Push via Firebase Cloud Messaging (optional) ----------
# Put the service-account JSON at ./secrets/firebase.json on the host;
# compose mounts ./secrets read-only at /app/secrets.
PUSH_ENABLED=false
FIREBASE_CREDENTIALS=/app/secrets/firebase.json

# ---------- JVM ----------
# Raise the percentage on a larger instance; 70% of a t3.small (2 GB)
# leaves room for Postgres and Nginx on the same host.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
