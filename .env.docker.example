# ============================================================
# Docker Compose environment — copy to .env in the project root
#   cp .env.docker.example .env
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-long-random-256-bit-secret-in-production
JWT_EXPIRATION_MS=86400000

# ---------- Mail (optional — OTP + notifications) ----------
# Set MAIL_ENABLED=true and add a Gmail App Password to send real email.
# When disabled, OTPs are logged to the backend console instead.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Google OAuth2 (optional) ----------
GOOGLE_CLIENT_ID=

# ---------- SMS via Twilio (optional — urgent alerts only) ----------
# When disabled, the SMS body is logged to the backend console instead of sent.
# TWILIO_FROM_NUMBER must be E.164, e.g. +15551234567
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Push via Firebase Cloud Messaging (optional) ----------
# Path (inside the backend container) to a Firebase service account JSON key.
# Mount it as a volume, e.g.  ./secrets/firebase.json:/app/firebase.json:ro
PUSH_ENABLED=false
FIREBASE_CREDENTIALS=
