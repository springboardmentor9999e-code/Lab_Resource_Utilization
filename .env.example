# Copy this file to `.env` locally and fill in real values.
# `.env` is gitignored - never commit it.
# The same variables must be set in your hosting dashboard (Render/Netlify).

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT signing key - base64-encoded 64-byte secret (generate: openssl rand -base64 64)
JWT_SECRET=your-64-byte-base64-secret

# SMTP (Gmail app password) - used for password reset / notifications
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password

# Spring profile (prod for deployment)
SPRING_PROFILES_ACTIVE=prod
