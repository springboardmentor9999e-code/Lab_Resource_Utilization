### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

### Editor / assistant tooling ###
.claude/

### Environment files (secrets — never commit) ###
# Only the *.example files are tracked. Real values live here and stay local.
.env
.env.*
!.env.*.example
!.env.example
backend/.env
frontend/.env

### Local property overrides (secrets — never commit) ###
# application.properties IS tracked: it holds the non-secret defaults a fresh clone
# needs, and every credential in it reads from an environment variable. Put real
# passwords in one of these instead — Spring picks up application-local.properties
# automatically with --spring.profiles.active=local.
application-local.properties
**/application-local.properties
*-secrets.properties
**/*-secrets.properties
**/application-*.properties
!**/application-prod.properties

### Credentials ###
# Keys and certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# SSH / deploy keys used to reach the cloud host
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
known_hosts

# Service-account and cloud credential files
firebase-service-account*.json
serviceAccountKey*.json
google-services.json
*service-account*.json
*credentials*.json
gcp-key*.json
.aws/
.azure/
.gcloud/
.pgpass

# Infrastructure state — Terraform state files contain plaintext secrets
*.tfstate
*.tfstate.*
.terraform/
*.tfvars

# Local compose overrides usually exist to hold real values
docker-compose.override.yml
docker-compose.override.yaml

### Host-mounted deployment secrets ###
# docker-compose.prod.yml bind-mounts ./secrets read-only into the backend.
# The directory is tracked (via its README) so the mount resolves; contents are not.
secrets/*
!secrets/.gitkeep

### Uploaded files ###
backend/uploads/
uploads/

### Database dumps and logs — real data, and dumps carry the password hashes ###
*.dump
*.sql.gz
*.sql.bak
backup/
backups/
*.log
logs/

### OS noise ###
.DS_Store
Thumbs.db
desktop.ini

### Node ###
node_modules/
frontend/dist/

### Generated diagram artifacts ###
# eer-diagram.svg and eer-diagram-4k.png ARE tracked (they are deliverables).
# The HTML wrapper only exists so a headless browser can rasterize the SVG.
database/eer-diagram.html
